{
  "threshold": 1,
  "minLines": 8,
  "minTokens": 60,
  "mode": "strict",
  "format": ["typescript", "tsx", "javascript", "css"],
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ]
}
