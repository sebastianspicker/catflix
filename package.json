{
  "name": "catflix",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first, supervised visual encounter catalogue for cats.",
  "license": "MIT",
  "homepage": "https://sebastianspicker.github.io/catflix/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/catflix.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/catflix/issues"
  },
  "keywords": [
    "cats",
    "local-first",
    "react",
    "phaser",
    "indexeddb",
    "accessibility"
  ],
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --base=/catflix/ && node scripts/prepare-pages.mjs",
    "preview:pages": "vite preview --base=/catflix/ --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
